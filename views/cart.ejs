<%- include('./partials/header') %>
<% const notices = Array.isArray(success) ? success : []; const errors = Array.isArray(error) ? error : []; %>
<% if (notices.length) { %><div class="toast fixed left-1/2 top-24 z-50 -translate-x-1/2 rounded-full bg-[#171717] px-5 py-3 text-sm font-medium text-white shadow-xl"><%= notices[0] %></div><% } %>
<% if (errors.length) { %><div class="toast fixed left-1/2 top-24 z-50 -translate-x-1/2 rounded-full bg-red-500 px-5 py-3 text-sm font-medium text-white shadow-xl"><%= errors[0] %></div><% } %>
<main class="mx-auto min-h-screen max-w-7xl px-5 py-10 md:px-10 md:py-16">
    <div class="mb-10"><p class="text-xs font-bold uppercase tracking-[.2em] text-[#6f5cff]">Your selection</p><h1 class="mt-3 text-4xl font-bold tracking-tight md:text-5xl">The bag edit.</h1><p class="mt-3 text-neutral-500">A considered collection of things you’re taking home.</p></div>
    <% if (!cartItems || cartItems.length === 0) { %>
        <div class="rounded-[2rem] border border-black/10 bg-white px-6 py-24 text-center"><div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#d7f36b] text-2xl"><i class="ri-shopping-bag-3-line"></i></div><h2 class="mt-6 text-2xl font-bold">Your bag is waiting.</h2><p class="mx-auto mt-2 max-w-md text-neutral-500">Add something you love from the collection and it will appear here.</p><a href="/shop" class="btn-primary mt-7 inline-flex rounded-full px-6 py-3 font-semibold">Browse the collection <i class="ri-arrow-right-up-line ml-2"></i></a></div>
    <% } else { %>
        <div class="grid gap-8 lg:grid-cols-[1fr_360px]">
            <section class="rounded-[2rem] border border-black/10 bg-white p-5 md:p-8"><div class="mb-6 flex items-center justify-between"><h2 class="text-xl font-bold">Your items</h2><span class="text-sm text-neutral-500"><%= cartItems.length %> item<%= cartItems.length === 1 ? '' : 's' %></span></div>
            <div class="space-y-5">
                <% cartItems.forEach(function(item) { %><div class="flex gap-4 border-b border-black/10 pb-5 last:border-0 last:pb-0"><div class="flex h-24 w-24 shrink-0 items-center justify-center rounded-2xl p-2" style="background-color:<%= item.bgcolor || '#ebe7df' %>"><% if (item.image) { %><img class="max-h-full max-w-full object-contain" src="data:image/jpeg;base64,<%= item.image.toString('base64') %>" alt="<%= item.name %>"><% } else { %><i class="ri-image-line text-2xl text-black/20"></i><% } %></div><div class="min-w-0 flex-1"><h3 class="font-bold"><%= item.name || 'Scatch bag' %></h3><p class="mt-1 text-sm text-neutral-500">Everyday essential</p><p class="mt-3 text-sm text-neutral-500">₹<%= item.price || 0 %> <%= item.discount ? '· save ₹' + item.discount : '' %></p><form class="mt-3" action="/removefromcart/<%= item._id %>" method="post"><button type="submit" class="text-sm font-semibold text-red-500 transition hover:text-red-700"><i class="ri-delete-bin-6-line mr-1"></i>Remove</button></form></div><strong class="text-lg">₹<%= (item.price || 0) - (item.discount || 0) %></strong></div><% }); %>
            </div></section>
            <aside class="h-fit rounded-[2rem] bg-[#171717] p-7 text-white"><h2 class="text-xl font-bold">Order summary</h2><div class="mt-7 space-y-4 text-sm text-white/65"><div class="flex justify-between"><span>Subtotal</span><span class="text-white">₹<%= cartTotal %></span></div><div class="flex justify-between"><span>Discount</span><span class="text-[#d7f36b]">− ₹<%= discountTotal %></span></div><div class="flex justify-between"><span>Platform fee</span><span class="text-white">₹<%= platformFee %></span></div><div class="flex justify-between"><span>Shipping</span><span class="text-[#d7f36b]">Free</span></div></div><div class="my-7 border-t border-white/15"></div><div class="flex items-end justify-between"><span class="text-white/65">Total</span><strong class="text-3xl">₹<%= bill %></strong></div><a href="/shop" class="mt-7 flex justify-center rounded-xl bg-[#d7f36b] px-4 py-3 font-bold text-black transition hover:bg-white">Continue shopping</a></aside>
        </div>
    <% } %>
</main>
<%- include('./partials/footer') %>
