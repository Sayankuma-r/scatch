<%- include('./partials/header') %>
<main class="mx-auto min-h-screen max-w-7xl px-5 py-10 md:px-10 md:py-16">
    <section class="relative overflow-hidden rounded-[2rem] bg-[#6f5cff] p-7 text-white md:p-12"><div class="absolute -right-10 -top-20 h-56 w-56 rounded-full border-[30px] border-white/10"></div><p class="text-xs font-bold uppercase tracking-[.2em] text-white/70">Your Scatch space</p><h1 class="relative mt-4 text-4xl font-bold md:text-6xl">Hey, <%= user.fullname || 'there' %>.</h1><p class="relative mt-4 max-w-md text-white/75">Everything you need for your next everyday adventure, in one place.</p></section>
    <div class="mt-8 grid gap-6 md:grid-cols-3"><div class="rounded-3xl border border-black/10 bg-white p-7"><i class="ri-user-smile-line text-2xl text-[#6f5cff]"></i><p class="mt-8 text-sm text-neutral-500">Full name</p><h2 class="mt-1 text-lg font-bold"><%= user.fullname %></h2></div><div class="rounded-3xl border border-black/10 bg-white p-7"><i class="ri-mail-line text-2xl text-[#6f5cff]"></i><p class="mt-8 text-sm text-neutral-500">Email</p><h2 class="mt-1 break-words text-lg font-bold"><%= user.email %></h2></div><div class="rounded-3xl border border-black/10 bg-[#d7f36b] p-7"><i class="ri-shopping-bag-3-line text-2xl"></i><p class="mt-8 text-sm text-black/50">In your bag</p><h2 class="mt-1 text-3xl font-bold"><%= Array.isArray(user.cart) ? user.cart.length : 0 %> <span class="text-base font-medium">items</span></h2></div></div>
    <section class="mt-8 rounded-[2rem] border border-black/10 bg-white p-7 md:p-10"><div class="flex flex-col justify-between gap-5 md:flex-row md:items-center"><div><p class="text-xs font-bold uppercase tracking-[.2em] text-[#6f5cff]">Next step</p><h2 class="mt-2 text-2xl font-bold">Ready for your next carry?</h2><p class="mt-2 text-neutral-500">Explore the collection and find your new everyday favourite.</p></div><div class="flex gap-3"><a href="/shop" class="btn-primary rounded-full px-5 py-3 text-sm font-semibold">Shop bags</a><a href="/cart" class="rounded-full border border-black/15 px-5 py-3 text-sm font-semibold">View bag</a></div></div></section>
</main>
<%- include('./partials/footer') %>
