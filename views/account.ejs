<%- include('./partials/header') %>
<div class="min-h-screen px-20 py-20 bg-gray-50">
    <div class="max-w-6xl mx-auto space-y-8">
        <div class="bg-white rounded-3xl shadow p-10">
            <h1 class="text-4xl font-bold mb-4">My Account</h1>
            <p class="text-gray-600">Manage your account details and view your profile information.</p>
        </div>

        <div class="grid gap-8 lg:grid-cols-3">
            <div class="lg:col-span-2 bg-white rounded-3xl shadow p-10">
                <h2 class="text-2xl font-semibold mb-6">Profile Information</h2>
                <div class="space-y-5 text-gray-700">
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-2">
                        <span class="font-medium">Full Name</span>
                        <span><%= user.fullname %></span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-2">
                        <span class="font-medium">Email</span>
                        <span><%= user.email %></span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-2">
                        <span class="font-medium">Phone</span>
                        <span><%= user.contact || 'Not provided' %></span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-2">
                        <span class="font-medium">Items in Cart</span>
                        <span><%= Array.isArray(user.cart) ? user.cart.length : 0 %></span>
                    </div>
                    <div class="flex flex-col sm:flex-row sm:justify-between gap-2">
                        <span class="font-medium">Orders</span>
                        <span><%= Array.isArray(user.orders) ? user.orders.length : 0 %></span>
                    </div>
                </div>
            </div>

            <div class="bg-white rounded-3xl shadow p-10">
                <h2 class="text-2xl font-semibold mb-6">Quick Actions</h2>
                <div class="space-y-4 text-gray-700">
                    <a href="/shop" class="block w-full text-center px-4 py-3 bg-blue-600 text-white rounded-2xl hover:bg-blue-700 transition">Continue shopping</a>
                    <a href="/cart" class="block w-full text-center px-4 py-3 bg-green-600 text-white rounded-2xl hover:bg-green-700 transition">View cart</a>
                    <a href="/users/logout" class="block w-full text-center px-4 py-3 bg-red-600 text-white rounded-2xl hover:bg-red-700 transition">Logout</a>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include('./partials/footer') %>
