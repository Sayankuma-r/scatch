<%- include('./partials/header') %>
<main class="soft-grid flex min-h-[calc(100vh-73px)] items-center px-5 py-16 md:px-10">
    <section class="mx-auto grid w-full max-w-5xl overflow-hidden rounded-[2rem] border border-black/10 bg-white shadow-xl md:grid-cols-2">
        <div class="bg-[#6f5cff] p-8 text-white md:p-12">
            <p class="text-xs font-bold uppercase tracking-[.2em] text-white/70">For the team</p>
            <h1 class="mt-5 text-4xl font-bold">Welcome to the studio.</h1>
            <p class="mt-5 leading-7 text-white/75">Manage the Scatch collection from one simple workspace.</p>
        </div>
        <div class="p-8 md:p-12">
            <p class="text-xs font-bold uppercase tracking-[.2em] text-[#6f5cff]">Admin workspace</p>
            <h2 class="mt-4 text-3xl font-bold">Choose what to do next</h2>
            <p class="mt-3 text-neutral-500">Product management is ready to use.</p>
            <div class="mt-8 grid gap-3">
                <a href="/owners/admin" class="btn-primary flex items-center justify-between rounded-xl px-5 py-4 font-semibold">Open studio <i class="ri-arrow-right-up-line"></i></a>
                <a href="/products" class="flex items-center justify-between rounded-xl border border-black/15 px-5 py-4 font-semibold transition hover:bg-[#f7f5f0]">View catalog <i class="ri-store-2-line"></i></a>
            </div>
        </div>
    </section>
</main>
<%- include('./partials/footer') %>
