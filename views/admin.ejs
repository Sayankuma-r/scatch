<%- include('./partials/header') %>
<% const notices = Array.isArray(success) ? success : []; const errors = Array.isArray(error) ? error : []; %>
<% if (notices.length) { %><div class="toast fixed left-1/2 top-24 z-50 -translate-x-1/2 rounded-full bg-[#171717] px-5 py-3 text-sm font-medium text-white shadow-xl"><%= notices[0] %></div><% } %>
<% if (errors.length) { %><div class="toast fixed left-1/2 top-24 z-50 -translate-x-1/2 rounded-full bg-red-500 px-5 py-3 text-sm font-medium text-white shadow-xl"><%= errors[0] %></div><% } %>
<main class="mx-auto min-h-screen max-w-7xl px-5 py-10 md:px-10 md:py-16">
    <section class="relative overflow-hidden rounded-[2rem] bg-[#171717] p-8 text-white md:p-12"><div class="absolute -right-10 -top-20 h-56 w-56 rounded-full border-[30px] border-white/10"></div><p class="text-xs font-bold uppercase tracking-[.2em] text-[#d7f36b]">Scatch studio</p><h1 class="relative mt-4 max-w-xl text-4xl font-bold md:text-6xl">Build the collection.</h1><p class="relative mt-4 max-w-lg text-white/60">Create products, review the live catalog, or remove a product that is no longer available.</p></section>
    <section class="mt-8 rounded-[2rem] border border-black/10 bg-white p-6 md:p-8"><div class="flex flex-col justify-between gap-4 border-b border-black/10 pb-6 sm:flex-row sm:items-center"><div><h2 class="text-2xl font-bold">Product catalog</h2><p class="mt-1 text-sm text-neutral-500"><%= products ? products.length : 0 %> product<%= products && products.length === 1 ? '' : 's' %> currently listed</p></div><a href="/products/create" class="btn-primary w-fit rounded-full px-5 py-3 text-sm font-semibold"><i class="ri-add-line mr-1"></i>Create product</a></div>
        <% if (!products || products.length === 0) { %><div class="py-16 text-center"><i class="ri-inbox-line text-4xl text-black/20"></i><h3 class="mt-4 text-xl font-bold">No products yet</h3><p class="mt-2 text-sm text-neutral-500">Create your first product to start the collection.</p></div><% } else { %>
        <div class="mt-6 divide-y divide-black/10"><% products.forEach(function(product) { %><div class="flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between"><div class="flex items-center gap-4"><div class="flex h-20 w-20 items-center justify-center rounded-2xl p-2" style="background-color:<%= product.bgcolor || '#ebe7df' %>"><% if (product.image) { %><img class="max-h-full max-w-full object-contain" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>"><% } else { %><i class="ri-image-line text-2xl text-black/20"></i><% } %></div><div><h3 class="font-bold"><%= product.name || 'Scatch bag' %></h3><p class="mt-1 text-sm text-neutral-500">₹<%= product.price || 0 %><%= product.discount ? ' · save ₹' + product.discount : '' %></p></div></div><form action="/products/<%= product._id %>/delete" method="post" onsubmit="return confirm('Delete this product permanently?')"><button type="submit" class="rounded-full border border-red-200 px-4 py-2 text-sm font-semibold text-red-500 transition hover:bg-red-50"><i class="ri-delete-bin-6-line mr-1"></i>Delete</button></form></div><% }); %></div>
        <% } %>
    </section>
</main>
<%- include('./partials/footer') %>
