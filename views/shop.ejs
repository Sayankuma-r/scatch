<%- include('./partials/header') %>

<!-- Success Message -->

<% if (success && success.length > 0) { %>
<div class="fixed top-5 left-1/2 -translate-x-1/2 z-50">
    <div class="px-6 py-3 rounded-xl bg-blue-500 shadow-lg">
        <span class="text-white font-medium"><%= success %></span>
    </div>
</div>
<% } %>

<div class="w-full min-h-screen flex bg-gray-100">

    <!-- Sidebar -->
    <div class="w-[22%] bg-white shadow-lg p-8">
        <h1 class="text-3xl font-bold mb-8 text-gray-800">Shop</h1>

        <!-- Sort -->
        <div class="mb-10">
            <h2 class="text-xl font-bold mb-4">Sort By</h2>
            <form action="/shop" method="GET">
                <select name="sortby" onchange="this.form.submit()" class="w-full border border-gray-300 px-4 py-3 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500">
                    <option value="popular">Popular</option>
                    <option value="newest">Newest</option>
                </select>
            </form>
        </div>

        <!-- Categories -->
        <div class="mb-10">
            <h2 class="text-xl font-bold mb-4">Categories</h2>
            <div class="flex flex-col gap-3">
                <a class="hover:text-blue-600 transition" href="#">New Collection</a>
                <a class="hover:text-blue-600 transition" href="#">All Products</a>
                <a class="hover:text-blue-600 transition" href="#">Discounted Products</a>
            </div>
        </div>

        <!-- Filters -->
        <div>
            <h2 class="text-xl font-bold mb-4">Filters</h2>
            <div class="flex flex-col gap-3">
                <a class="hover:text-blue-600 transition" href="#">Availability</a>
                <a class="hover:text-blue-600 transition" href="#">Discount</a>
            </div>
        </div>
    </div>

    <!-- Products Section -->
    <div class="w-[78%] p-10">
        <div class="flex justify-between items-center mb-10">
            <h1 class="text-4xl font-bold text-gray-800">Explore Products</h1>
            <span class="bg-white px-4 py-2 rounded-xl shadow"><%= products ? products.length : 0 %> Products</span>
        </div>

        <!-- Product Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">

            <% if (!products || products.length === 0) { %>
                <% for (let i = 1; i <= 8; i++) { %>
                    <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                        <div class="h-60 bg-gray-200 flex items-center justify-center">
                            <span class="text-gray-500 text-lg">Product <%= i %></span>
                        </div>
                        <div class="p-5">
                            <h3 class="text-xl font-bold text-gray-800">Premium Bag</h3>
                            <p class="text-gray-500 mt-2">Stylish and premium quality bag.</p>
                            <div class="flex justify-between items-center mt-5">
                                <span class="text-2xl font-bold text-blue-600">₹999</span>
                                <button class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition">Add</button>
                            </div>
                        </div>
                    </div>
                <% } %>
            <% } else { %>
                <% products.forEach(function(product) { %>
                    <div class="bg-white rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-2 transition-all duration-300">
                        <div class="w-full h-60 flex items-center justify-center" style="background-color:<%= product.bgcolor %>">
                            <% if (product.image) { %>
                                <img class="h-44 object-contain hover:scale-110 transition duration-300" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>" />
                            <% } else { %>
                                <div class="text-gray-500">No Image</div>
                            <% } %>
                        </div>
                        <div class="p-5" style="background-color:<%= product.panelcolor %>; color:<%= product.textcolor %>;">
                            <h3 class="text-xl font-bold"><%= product.name %></h3>
                            <p class="opacity-80 text-sm mt-1">Premium Quality Product</p>
                            <div class="flex justify-between items-center mt-5">
                                <h4 class="text-2xl font-bold">₹<%= product.price %></h4>
                                <a href="/addtocart/<%= product._id %>" class="w-11 h-11 flex items-center justify-center rounded-full bg-white text-black shadow-lg hover:scale-110 transition">
                                    <i class="ri-shopping-cart-line text-xl"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>

<%- include('./partials/footer') %>
