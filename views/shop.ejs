<%- include('./partials/header') %>
<% const notice = Array.isArray(success) ? success : []; %>
<% if (notice.length) { %><div class="toast fixed left-1/2 top-24 z-50 -translate-x-1/2 rounded-full bg-[#171717] px-5 py-3 text-sm font-medium text-white shadow-xl"><%= notice[0] %></div><% } %>
<main class="mx-auto min-h-screen max-w-7xl px-5 py-10 md:px-10 md:py-16">
    <div class="flex flex-col justify-between gap-5 border-b border-black/10 pb-8 md:flex-row md:items-end">
        <div><p class="text-xs font-bold uppercase tracking-[.2em] text-[#6f5cff]">The collection</p><h1 class="mt-3 text-4xl font-bold tracking-tight md:text-6xl">Find your everyday.</h1><p class="mt-3 max-w-lg text-neutral-500">Pieces that keep up, look good and make the daily carry feel a little lighter.</p></div>
        <div class="flex items-center gap-3"><span class="rounded-full bg-white px-4 py-2 text-sm font-medium shadow-sm"><%= products ? products.length : 0 %> pieces</span><form action="/shop" method="GET"><select name="sortby" onchange="this.form.submit()" class="rounded-full border border-black/10 bg-white px-4 py-2 text-sm outline-none"><option value="popular">Featured</option><option value="newest">Newest</option></select></form></div>
    </div>
    <div class="mt-10 flex gap-2 overflow-auto pb-2 text-sm font-medium"><span class="whitespace-nowrap rounded-full bg-black px-4 py-2 text-white">All bags</span><span class="whitespace-nowrap rounded-full border border-black/10 bg-white px-4 py-2">New arrivals</span><span class="whitespace-nowrap rounded-full border border-black/10 bg-white px-4 py-2">Best sellers</span><span class="whitespace-nowrap rounded-full border border-black/10 bg-white px-4 py-2">Under ₹2,000</span></div>
    <% if (!products || products.length === 0) { %>
        <div class="mt-12 rounded-[2rem] border border-dashed border-black/20 bg-white px-6 py-20 text-center"><div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-[#d7f36b] text-2xl"><i class="ri-shopping-bag-3-line"></i></div><h2 class="mt-6 text-2xl font-bold">The shelves are getting ready.</h2><p class="mx-auto mt-2 max-w-md text-neutral-500">No products have been added yet. Check back soon for the first Scatch drop.</p></div>
    <% } else { %>
        <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <% products.forEach(function(product) { const price = Number(product.price) || 0; const discount = Number(product.discount) || 0; %>
            <article class="product-card overflow-hidden rounded-[1.5rem] border border-black/5 bg-white">
                <div class="relative flex h-72 items-center justify-center overflow-hidden p-6" style="background-color:<%= product.bgcolor || '#ebe7df' %>">
                    <% if (discount > 0) { %><span class="absolute left-4 top-4 rounded-full bg-[#d7f36b] px-3 py-1 text-xs font-bold">SAVE ₹<%= discount %></span><% } %>
                    <% if (product.image) { %><img class="h-full w-full object-contain transition duration-500 hover:scale-105" src="data:image/jpeg;base64,<%= product.image.toString('base64') %>" alt="<%= product.name %>"><% } else { %><i class="ri-image-line text-4xl text-black/20"></i><% } %>
                </div>
                <div class="p-5"><div class="flex items-start justify-between gap-3"><div><h2 class="font-bold"><%= product.name || 'Scatch bag' %></h2><p class="mt-1 text-sm text-neutral-500">Everyday essential</p></div><span class="text-lg font-bold">₹<%= price - discount %></span></div><a href="/addtocart/<%= product._id %>" class="btn-primary mt-5 flex w-full items-center justify-center rounded-xl px-4 py-3 text-sm font-semibold">Add to bag <i class="ri-arrow-right-up-line ml-2"></i></a></div>
            </article>
        <% }); %>
        </div>
    <% } %>
</main>
<%- include('./partials/footer') %>
